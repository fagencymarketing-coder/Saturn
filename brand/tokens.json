{
  "$meta": {
    "name": "Saturn — Design Tokens",
    "version": "1.0.0",
    "source": "Логобук «Сатурн», Москва 2024",
    "site": "https://saturn.systems",
    "legend": {
      "logobook": "Зафиксировано в брендбуке — не менять.",
      "web-extension": "Выведено под веб в логике бренда — можно калибровать."
    }
  },

  "color": {
    "brand": {
      "orange":       { "value": "#FF4200", "rgb": "255,66,0",  "source": "logobook", "role": "Акцент: кнопки, ссылки, знак, активные состояния" },
      "black":        { "value": "#000000", "rgb": "0,0,0",     "source": "logobook", "role": "Логотип, заголовки, тёмный фон" },
      "white":        { "value": "#FFFFFF", "rgb": "255,255,255","source": "logobook","role": "Основной фон, знак на оранжевом/чёрном" }
    },
    "orangeState": {
      "hover":        { "value": "#E63B00", "source": "web-extension", "role": "Наведение на оранжевый элемент" },
      "active":       { "value": "#C43200", "source": "web-extension", "role": "Нажатие; оранжевый текст на светлом для контраста" },
      "tint":         { "value": "#FFF0EA", "source": "web-extension", "role": "Мягкая подложка: бейджи, выделенные блоки" }
    },
    "text": {
      "primary":      { "value": "#1A1A1A", "source": "web-extension", "role": "Основной текст на светлом фоне" },
      "secondary":    { "value": "#6B6560", "source": "web-extension", "role": "Подписи, лиды, вторичный текст" },
      "muted":        { "value": "#9A938C", "source": "web-extension", "role": "Пометки, плейсхолдеры, disabled" }
    },
    "surface": {
      "background":   { "value": "#FFFFFF", "source": "logobook",      "role": "Базовый фон" },
      "surface":      { "value": "#F6F5F3", "source": "web-extension", "role": "Тёплый фон секций и карточек" },
      "surface2":     { "value": "#EFEDE9", "source": "web-extension", "role": "Вложенные поверхности" },
      "border":       { "value": "#E7E3DE", "source": "web-extension", "role": "Линии, разделители, обводка полей" },
      "borderStrong": { "value": "#D2CCC4", "source": "web-extension", "role": "Акцентные границы" }
    },
    "dark": {
      "background":   { "value": "#0E0D0C", "source": "web-extension" },
      "surface":      { "value": "#1A1817", "source": "web-extension" },
      "text":         { "value": "#F3F1EE", "source": "web-extension" },
      "textSecondary":{ "value": "#A8A29B", "source": "web-extension" },
      "border":       { "value": "#2C2926", "source": "web-extension" }
    }
  },

  "typography": {
    "$note": "Оригинал логобука — Gotham Pro (Medium/Light). Веб-замена с кириллицей — Montserrat (Google Fonts).",
    "fontFamily": {
      "print":  { "value": "Gotham Pro", "weights": ["Medium", "Light", "Bold"], "source": "logobook" },
      "web":    { "value": "\"Montserrat\", system-ui, -apple-system, \"Segoe UI\", Arial, sans-serif", "source": "web-extension" },
      "mono":   { "value": "ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, monospace" }
    },
    "weight": { "light": 300, "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
    "scale": {
      "h1":    { "size": "3.5rem",    "px": 56, "mobilePx": 36, "weight": 800, "lineHeight": 1.05, "letterSpacing": "-0.02em" },
      "h2":    { "size": "2.5rem",    "px": 40, "mobilePx": 28, "weight": 700, "lineHeight": 1.1,  "letterSpacing": "-0.015em" },
      "h3":    { "size": "1.75rem",   "px": 28, "mobilePx": 22, "weight": 600, "lineHeight": 1.2,  "letterSpacing": "-0.01em" },
      "lead":  { "size": "1.25rem",   "px": 20, "weight": 400, "lineHeight": 1.5, "color": "text.secondary" },
      "body":  { "size": "1.0625rem", "px": 17, "mobilePx": 16, "weight": 400, "lineHeight": 1.6, "maxWidth": "62ch" },
      "small": { "size": "0.875rem",  "px": 14, "weight": 400, "lineHeight": 1.5, "color": "text.secondary" },
      "label": { "size": "0.8125rem", "px": 13, "weight": 600, "lineHeight": 1.4, "textTransform": "uppercase", "letterSpacing": "0.16em", "color": "brand.orange" }
    }
  },

  "spacing": {
    "$note": "Сетка 8pt (+шаг 4 для мелких зазоров). Одна шкала на padding, margin, gap.",
    "2xs": "4px", "xs": "8px", "sm": "12px", "md": "16px",
    "lg": "24px", "xl": "32px", "2xl": "48px", "3xl": "64px", "4xl": "96px",
    "sectionGapDesktop": "64px–96px",
    "sectionGapMobile": "40px–56px",
    "cardPadding": "24px–32px",
    "containerMaxWidth": "1200px",
    "containerGutter": "24px"
  },

  "radius": {
    "$note": "Знак — окружность, система тяготеет к округлости.",
    "none": "0", "sm": "8px", "md": "12px", "lg": "20px", "xl": "28px", "pill": "999px",
    "defaults": { "button": "12px", "input": "12px", "card": "20px", "tag": "999px" }
  },

  "button": {
    "shared": { "height": "52px", "padding": "16px 32px", "fontSize": "16px", "fontWeight": 600, "letterSpacing": "0.01em", "radius": "12px", "focusRing": "0 0 0 4px rgba(255,66,0,0.38)" },
    "primary":   { "background": "#FF4200", "color": "#FFFFFF", "hover": "#E63B00", "active": "#C43200" },
    "secondary": { "background": "transparent", "color": "#1A1A1A", "border": "2px solid #1A1A1A", "hover": "background #1A1A1A / color #FFFFFF", "onDark": "border+text #FFFFFF" },
    "ghost":     { "background": "transparent", "color": "#FF4200", "hover": "underline" }
  },

  "pattern": {
    "$note": "Фирменный паттерн из полукругов — та же геометрия окружностей, что и в знаке.",
    "usage": "Акцентная заливка блоков, футер, шапки на транспорте/документации",
    "variants": ["оранжевый #FF4200 на белом", "белый на оранжевом"]
  }
}
